READ_ME {
Lending, and the name that says how long a loan lasts.

One borrowed parameter, so there is only one thing the answer could be
borrowed from and nothing has to be named.
}

PREP {
    fn.loan.str 'echo' [loan.str 'text'] {
        give ['text'];
    }

    # Two borrowed parameters. The answer comes from one of them, the compiler
    # cannot see which, so the loan is named and everything on it says so.
    fn.loan.'life'.str 'longer' [loan.'life'.str 'a', loan.'life'.str 'b'] {
        if count['a'] >== count['b'] {
            give ['a'];
        } else {
            give ['b'];
        }
    }
}

START {
    var.str 'greeting' = [*hello there*];
    var.str 'reply' = [*hi*];

    var.loan.str 'winner' = [longer[loan 'greeting', loan 'reply']];
    print.stdout[str:*longer: * 'winner' \n];

    var.int64 'area' = [*3* x *4*];
    var.int64 'cube' = [*2* ^ *3*];
    print.stdout[str:*area * 'area' str:*, cube * 'cube' \n];
}
