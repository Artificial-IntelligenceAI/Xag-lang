READ_ME {
A library that shares constants. `MOST` and `ORIGIN` are exported and reach a
program as `lim.'MOST'` and `lim.'ORIGIN'`; `SECRET` is this file's alone, and
`lim.'SECRET'` from a program is a name nothing declared.
}
LIBRARY {
    struct.export 'point' [int64 'x', int64 'y']
    const.export.int64 'MOST' = [*100*];
    const.export.point 'ORIGIN' = [*0* *0*];
    const.int64 'SECRET' = [*7*];
    fn.export.int64 'secretly' [int64 'n'] { give ['n' + 'SECRET']; }
}
ITMT {
    print.stdout['MOST' str:* * 'ORIGIN'.x str:* * secretly[*1*] \n];
}
