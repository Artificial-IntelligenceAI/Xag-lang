build/
compile_commands.json
.cache/
.DS_Store
generator/target/
bench/out/

# What `xagc build` leaves beside an example: the program itself, named after
# the source with the `.xag` taken off. Eight of them were committed once, by a
# check that built every example and a `git add -A` that believed it.
examples/*
!examples/*.xag

# The same under tests/units: `xagc build` on a test program leaves the binary
# beside its source, and two of those were committed the same way.
tests/units/*/*
!tests/units/*/*.xag
!tests/units/*/*.toml
!tests/units/*/*.txt
